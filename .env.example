# ─── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://mongo:27017/finance_ledger

# Session (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=change_me_to_a_long_random_string

# Google OAuth  (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Email — Nodemailer (Gmail example; use App Password if 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Personal Finance Ledger <no-reply@example.com>"

# Web Push VAPID keys
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# Multi-currency — Open Exchange Rates (https://openexchangerates.org/)
OXR_APP_ID=

# ─── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_VAPID_PUBLIC_KEY=
