# =============================================================================
# GitLab CI/CD Variable Configuration — personalfinanceledgerapp
# =============================================================================
#
# USAGE:
#   1. Copy this file:  cp scripts/gitlab-ci-vars.env.example scripts/gitlab-ci-vars.env
#   2. Fill in every value below
#   3. Run:  GITLAB_TOKEN=<your-api-token> GITLAB_PROJECT=<group/project> \
#              bash scripts/configure-gitlab-ci.sh
#
# NEVER commit gitlab-ci-vars.env — it contains secrets and is gitignored.
# =============================================================================


# =============================================================================
# GLOBAL VARIABLES (available in all environments, all branches)
# =============================================================================

# GitHub Classic PAT used by GitLab runners to push/pull from GHCR.
# Create at: https://github.com/settings/tokens
# Required scopes: write:packages, read:packages
# (GitLab runners are outside GitHub Actions, so GITHUB_TOKEN is not available)
CR_PAT=

# JWT secret passed to the backend container during integration tests.
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# OR:
#   openssl rand -hex 64
JWT_SECRET=

# Codecov upload token — optional, only needed if you want coverage reports.
# Find at: https://app.codecov.io → your project → Settings → General
CODECOV_TOKEN=


# =============================================================================
# STAGING ENVIRONMENT VARIABLES (scoped to environment: staging)
# These are only injected into jobs that declare `environment: name: staging`
# =============================================================================

# IP address or hostname of your staging server.
# Example: 54.123.45.67  or  staging.example.com
STAGING_HOST=

# SSH username on the staging server.
# Common values: ubuntu (AWS EC2), ec2-user (Amazon Linux), root (VPS)
STAGING_USER=ubuntu

# Path to the LOCAL private key file whose public key is in the server's
# authorized_keys. The script reads this file and uploads its contents
# to GitLab as a File-type variable (required for multiline keys).
# Example: /home/jp/.ssh/id_ed25519  or  ~/.ssh/id_rsa
STAGING_SSH_KEY_FILE=~/.ssh/id_ed25519

# GitHub Classic PAT with read:packages scope ONLY.
# Used on the staging server to `docker login ghcr.io` and pull images.
# Keep separate from CR_PAT so the server has minimal privileges.
# Create at: https://github.com/settings/tokens → scopes: read:packages
GHCR_READ_TOKEN=

# Full base URL of the staging backend (used by Newman, Playwright, k6, ZAP).
# Must be reachable from the GitLab runner (public IP or VPN-accessible host).
# Example: http://54.123.45.67:5000
# Note: the frontend is accessible on the same host at port 80.
STAGING_URL=
